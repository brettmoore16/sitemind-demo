# Copy to .env locally; never upload secrets. Node 22+ supports --env-file=.env.
APP_MODE=demo
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development
# Service mode requires a separate server, HTTPS in production, and Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only webhook/system jobs use service_role. Normal requests always use the user's JWT.
SUPABASE_SERVICE_ROLE_KEY=
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Keep disabled until explicitly approved. Do not register provider webhooks yet.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_URL=
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
JOB_SECRET=
